# ILAL Minimal Swap Example
# Copy to .env and fill in your values

# Your ILAL API key (created at https://ilal.tech/dashboard/api-keys)
ILAL_API_KEY=ilal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private key of the wallet that will sign transactions (0x-prefixed)
PRIVATE_KEY=0xyour_private_key_here

# Optional: override the default API base URL
# ILAL_API_BASE=https://ilal-mvp-production.up.railway.app/api/v1
